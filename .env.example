# Public site origin used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign form anti-spam tokens. A random per-process secret is
# generated when this is unset, which is fine for local development only.
FORM_TOKEN_SECRET=

# Form delivery adapters. "console" logs redacted submissions locally and
# requires no credentials. Real adapters are selected here once credentials exist.
CRM_ADAPTER=console
EMAIL_ADAPTER=console
